PORT=5000
MONGO_URI=mongodb+srv://<user>:<pass>@cluster.mongodb.net/krishimitra?retryWrites=true&w=majority
JWT_SECRET=change-this-to-a-long-random-secret
PYTHON_SERVICE_URL=http://localhost:8000
SERVICE_KEY=krishimitra-internal-key-change-in-prod
TAVILY_API_KEY=tvly-...
CLIENT_URL=http://localhost:3000
# Groq — powers the KrishiBot chat assistant (routes/chat.js). Required: the
# Groq client is constructed at module load, so the whole server fails to boot
# when this is missing, not just the chatbot.
GROQ_API_KEY=gsk_...
# Optional. Identifies this deployment to OpenStreetMap Nominatim, which the
# village search uses. Their policy asks for an honest app name and contact.
NOMINATIM_USER_AGENT=KrishiMitra/1.0 (+https://github.com/Nakshatra480/Krishi-Mitra)
